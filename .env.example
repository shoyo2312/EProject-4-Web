# Spring Cloud Gateway. Next proxies /api/* here (see next.config.ts), so this
# is a server-side value — it is never exposed to the browser.
API_GATEWAY_URL=http://localhost:8080

# Social login. These are public client *identifiers*, not secrets: the browser
# sends them to Google/Facebook to obtain a token, and auth-service is what
# verifies that token — with GOOGLE_CLIENT_IDS / FB_APP_ID / FB_APP_SECRET on
# its own side. The web client id listed here must also appear in
# auth-service's GOOGLE_CLIENT_IDS, or every Google login is rejected on `aud`.
#
# Leave either one empty and its row answers with a "not configured on this
# deployment" message instead of opening a broken dialog.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_FACEBOOK_APP_ID=

NEXT_PUBLIC_TURNSTILE_SITE_KEY